{
  "name": "mula",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/host-grotesk": "^0.4.1",
    "@expo/ui": "~57.0.25",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.26",
    "lucide-react-native": "^1.58.0",
    "nativewind": "^4.2.7",
    "papaparse": "^5.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "29.5.14",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "node tests/e2e/smoke.mjs",
    "parse-archive": "node scripts/parse-archive.ts",
    "postinstall": "patch-package",
    "icons": "node scripts/make-icons.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": ["expo-widgets"]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/.*$": "<rootDir>/tests/mocks/icon.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
