{
  "expo": {
    "name": "Mula",
    "slug": "mula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mula",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.khaledsharara.mula",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "io.github.khaledsharara.mula",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2C42C8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F45D0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F1",
          "dark": {
            "backgroundColor": "#131315"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.io.github.khaledsharara.mula",
          "widgets": [
            {
              "name": "ReviewInbox",
              "displayName": "Review inbox",
              "description": "Payments waiting for you to check, and how long they have waited.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/with-mula-intents",
      "./plugins/with-free-signing",
      "./plugins/with-android-release-signing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
