+  /// The configured app group, unless this build can't open it. Apps re-signed with a free Apple ID
+  /// by SideStore / AltStore get their app groups renamed (the team ID is appended), so the name in
+  /// Info.plist no longer matches the entitlement and the app and its widget stop sharing data.
+  /// Falls back to the renamed group, listed under ALTAppGroups (in this bundle or, for an
+  /// extension, in the containing app) or in the embedded provisioning profile: the first one this
+  /// process can actually open.
+  static func resolveAppGroupIdentifier() -> String? {
+    let configured = Bundle.main.object(forInfoDictionaryKey: "ExpoWidgetsAppGroupIdentifier") as? String
+    var candidates: [String] = configured.map { [$0] } ?? []
+
+    var bundles: [Bundle] = [Bundle.main]
+    let containingApp = Bundle.main.bundleURL.deletingLastPathComponent().deletingLastPathComponent()
+    if containingApp.pathExtension == "app", let app = Bundle(url: containingApp) {
+      bundles.append(app)
+    }
+    for bundle in bundles {
+      candidates += (bundle.object(forInfoDictionaryKey: "ALTAppGroups") as? [String]) ?? []
+      candidates += provisionedAppGroups(in: bundle)
+    }
+
+    let related = candidates.filter { group in configured.map { group.hasPrefix($0) } ?? true }
+    let ordered = related + candidates.filter { !related.contains($0) }
+    return ordered.first { FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: $0) != nil } ?? configured
+  }
+
+  private static func provisionedAppGroups(in bundle: Bundle) -> [String] {
+    guard let url = bundle.url(forResource: "embedded", withExtension: "mobileprovision"),
+          let data = try? Data(contentsOf: url),
+          let text = String(data: data, encoding: .isoLatin1),
+          let start = text.range(of: "<?xml"),
+          let end = text.range(of: "</plist>"),
+          let plist = try? PropertyListSerialization.propertyList(
+            from: Data(text[start.lowerBound..<end.upperBound].utf8), options: [], format: nil) as? [String: Any],
+          let entitlements = plist["Entitlements"] as? [String: Any]
+    else { return [] }
+    return (entitlements["com.apple.security.application-groups"] as? [String]) ?? []
+  }
